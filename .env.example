# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL and server-only service-role key.
# Never prefix the service-role key with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# POS login passcodes. Optional — when unset the POS falls back to the
# built-in defaults admin123 / staff123. Set them to something private.
ADMIN_PASSCODE=
STAFF_PASSCODE=
